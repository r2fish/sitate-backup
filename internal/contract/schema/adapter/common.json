{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://sitate.invalid/schema/adapter/common.json",
 "$defs": {
  "semver": {
   "type": "string",
   "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
   "maxLength": 64
  },
  "name": {
   "type": "string",
   "pattern": "^[a-z0-9-]{1,32}$"
  },
  "adapter_code": {
   "type": "string",
   "pattern": "^adapter:[a-z0-9-]{1,32}:[A-Z][A-Z0-9_]{0,63}$",
   "maxLength": 128
  },
  "resource": {
   "type": "object",
   "required": [
    "type",
    "id"
   ],
   "additionalProperties": false,
   "properties": {
    "type": {
     "enum": [
      "instance",
      "volume",
      "security_group",
      "workdir",
      "scratch",
      "container",
      "process"
     ]
    },
    "id": {
     "type": "string",
     "pattern": "^[^\\x00-\\x1f/]{1,256}$"
    }
   }
  },
  "resource_session": {
   "type": "object",
   "required": [
    "type",
    "id",
    "session_id"
   ],
   "additionalProperties": false,
   "properties": {
    "type": {
     "enum": [
      "instance",
      "volume",
      "security_group",
      "workdir",
      "scratch",
      "container",
      "process"
     ]
    },
    "id": {
     "type": "string",
     "pattern": "^[^\\x00-\\x1f/]{1,256}$"
    },
    "session_id": {
     "anyOf": [
      {
       "$ref": "https://sitate.invalid/schema/cli/common.json#/$defs/ident"
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "generic_detail": {
   "type": "object",
   "maxProperties": 16,
   "additionalProperties": {
    "$ref": "https://sitate.invalid/schema/cli/common.json#/$defs/defvalue"
   }
  },
  "internal_detail": {
   "type": "object",
   "required": [
    "component"
   ],
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "adapter"
    },
    "reason": {
     "enum": [
      "contract",
      "exit_code",
      "output",
      "request"
     ]
    }
   }
  },
  "not_implemented_detail": {
   "type": "object",
   "required": [
    "feature"
   ],
   "additionalProperties": false,
   "properties": {
    "feature": {
     "$ref": "https://sitate.invalid/schema/cli/common.json#/$defs/feature"
    }
   }
  },
  "resources_prop": {
   "type": "array",
   "items": {
    "$ref": "https://sitate.invalid/schema/adapter/common.json#/$defs/resource"
   }
  }
 }
}
