{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://sitate.invalid/schema/app/send-fields.json",
 "title": "送る欄の表のデータ(spec 3.7)。主プロセスの許可リスト。<i> は参照トークン * で表し、1 欄 1 要素。",
 "type": "object",
 "required": ["format", "rows"],
 "additionalProperties": false,
 "properties": {
  "format": {"const": "sitate.send-fields/v1"},
  "rows": {"type": "array", "minItems": 1, "items": {
   "type": "object", "required": ["where", "fields"], "additionalProperties": false,
   "properties": {
    "where": {"type": "string", "pattern": "^[a-z][a-z-]*( [a-z][a-z-]*)*$"},
    "when": {"type": "object", "required": ["codes", "on"], "additionalProperties": false, "properties": {
      "codes": {"type": "array", "minItems": 1, "items": {"$ref": "https://sitate.invalid/schema/cli/codes.json#/$defs/code"}},
      "on": {"type": "array", "minItems": 1, "items": {"enum": ["error", "warnings"]}}}},
    "fields": {"type": "array", "minItems": 1, "items": {
     "type": "object", "required": ["pointer"], "additionalProperties": false,
     "properties": {"pointer": {"type": "string", "pattern": "^(/[A-Za-z0-9_*]+)+$"}, "transform": {"const": "path_ref"}}}}
   }}}
 }
}
