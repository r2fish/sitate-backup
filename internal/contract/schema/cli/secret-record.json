{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://sitate.invalid/schema/cli/secret-record.json",
 "$comment": "標準出力の先頭レコード(spec 3.1.4。gate 経由で --secret-fd を読み替えたもの)。アプリは schema だけで見分ける。",
 "type": "object",
 "required": [
  "schema",
  "kind",
  "words",
  "keyring_version"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "sitate.secret-string/v1"
  },
  "kind": {
   "const": "recovery_phrase"
  },
  "words": {
   "type": "array",
   "minItems": 24,
   "maxItems": 24,
   "items": {
    "type": "string",
    "pattern": "^[a-z]{3,8}$"
   }
  },
  "keyring_version": {
   "type": "integer",
   "minimum": 1
  }
 }
}
