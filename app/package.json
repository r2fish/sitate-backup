{
  "name": "sitate-app",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "description": "Sitate-backup クライアントアプリ(Electron + TypeScript)。骨格。中身は WP U3a・U3b。",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/contract/*.test.ts\" \"test/u3a/*.test.ts\" \"test/e2e/*.test.ts\" \"src/kit/*.test.ts\"",
    "test:e2e": "node --test \"test/e2e/*.test.ts\"",
    "test:contract": "node --test \"test/contract/*.test.ts\"",
    "test:u3a": "node --test --test-skip-pattern=\"\\\\[u3b\\\\]\" \"test/contract/*.test.ts\" \"test/u3a/*.test.ts\"",
    "test:u3b": "r=0; node --test \"src/kit/*.test.ts\" || r=1; node --test --test-name-pattern=\"\\\\[u3b\\\\]\" \"test/contract/*.test.ts\" || r=1; exit $r",
    "driver": "node test/e2e/cli.ts",
    "test:smoke": "node --test --test-timeout=120000 \"test/smoke/*.test.ts\"",
    "contract-status": "node scripts/contract-status.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:size": "eslint src test scripts",
    "build": "node scripts/build-app.mjs --mode product",
    "build:test": "node scripts/build-app.mjs --mode test",
    "test:real": "node --test --test-timeout=1500000 \"test/real/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ssh2": "1.15.6",
    "electron": "45.2.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "ajv": "8.20.0",
    "ssh2": "1.17.0"
  }
}
